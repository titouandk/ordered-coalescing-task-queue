{
  "name": "ordered-coalescing-task-queue",
  "version": "1.0.0",
  "description": "An Ordered Coalescing Task Queue.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/titouandk/ordered-coalescing-task-queue.git"
  },
  "bugs": {
    "url": "https://github.com/titouandk/ordered-coalescing-task-queue/issues"
  },
  "homepage": "https://github.com/titouandk/ordered-coalescing-task-queue#readme",
  "engines": {
    "node": ">=18"
  },
  "main": "dist/index.js",
  "scripts": {
    "test": "vitest",
    "clean": "node --eval \"fs.rmSync('dist', { recursive: true, force: true })\"",
    "build": "npm run clean && tsc",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint src/",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:types": "vitest run --config vitest.typecheck.config.ts --typecheck --typecheck.only",
    "prepublishOnly": "npm run format:check && npm run lint && npm run test:run && npm run build"
  },
  "keywords": [
    "queue",
    "ordered",
    "coalesce",
    "coalescing",
    "task-queue",
    "typescript"
  ],
  "author": "titouandk",
  "license": "MIT",
  "type": "module",
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@eslint/json": "1.0.1",
    "@eslint/markdown": "7.5.1",
    "eslint": "10.0.3",
    "eslint-config-prettier": "10.1.8",
    "globals": "17.4.0",
    "lint-staged": "16.3.2",
    "prettier": "3.8.1",
    "simple-git-hooks": "2.13.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.56.1",
    "vitest": "4.1.11"
  },
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "lint-staged": {
    "*": "prettier --write --ignore-unknown"
  },
  "simple-git-hooks": {
    "pre-commit": "npx lint-staged && npx tsc --noEmit"
  }
}